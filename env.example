# SPECTRE Capture — example configuration. NO SECRET BELONGS IN THIS FILE OR IN GIT.
# Real values live only in: Apps Script > Project Settings > Script Properties (owner account),
# the owner's Apple Developer account, and the phones' Keychain after enrolment.

# --- Apps Script Script Properties (set by spectreSetup / spectreSetWebAppUrl, never by hand in git)
# CFG_FOLDER_ID=<created automatically by spectreSetup()>
# CFG_WEBAPP_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
# CFG_DRIVE_API_BASE=   (leave empty in production; tests only)
# CFG_TEST_MODE=        (leave empty in production; tests only)

# --- Signing (used by scripts/configure_signing.sh, local only)
SPECTRE_BUNDLE_ID=ch.example.spectrecapture
SPECTRE_APPLE_TEAM_ID=XXXXXXXXXX

# --- Local test tooling
SPECTRE_NODE=/opt/homebrew/bin/node
# SPECTRE_LARGE_TEST_BYTES=2684354560   # enable the multi-GB T02 run
