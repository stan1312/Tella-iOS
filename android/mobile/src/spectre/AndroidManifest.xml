<?xml version="1.0" encoding="utf-8"?>
<!-- SPECTRE Capture (flavor "spectre"): deposit screens, invitation links, background upload. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Long uploads continue in a visible foreground "data sync" job (WorkManager). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <activity
            android:name="org.horizontal.tella.mobile.spectre.SpectreStatusActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- spectre://enroll?v=1&endpoint=…&code=… (QR shown in person by the owner).
             The activity requires the unlocked app and an explicit confirmation. -->
        <activity
            android:name="org.horizontal.tella.mobile.spectre.SpectreEnrollActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="spectre" android:host="enroll" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
